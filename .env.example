# Required
BOT_TOKEN=123456789:AA...your-bot-token...

# Strongly recommended: comma-separated Telegram user IDs allowed to use the bot
ALLOWED_USER_IDS=123456789

# Optional
ADMIN_CHAT_ID=
MAX_USER_STORAGE_MB=2048

# Web board (optional, off unless WEB_BASE_URL is set). Requires ALLOWED_USER_IDS.
# Public https URL of the board, no path, e.g. https://board.example.com
# (http is accepted only for http://localhost and http://127.0.0.1).
WEB_BASE_URL=
# Port the board listens on inside the container.
WEB_PORT=8080
# docker-compose.yml publishes no host port, so a deployment without the board is unchanged.
# - A tunnel/reverse-proxy container on the same compose network can reach the board
#   at bot:<WEB_PORT>, nothing more is needed.
# - For a tunnel running on the host, publish the port on the host's loopback
#   (127.0.0.1:<WEB_PORT>) by uncommenting this line (Compose reads COMPOSE_FILE from .env):
# COMPOSE_FILE=docker-compose.yml:docker-compose.web.yml
